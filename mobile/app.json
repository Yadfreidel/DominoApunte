{
  "expo": {
    "name": "Dominó",
    "slug": "domino-puntos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Dominó",
      "themeColor": "#070B24",
      "backgroundColor": "#070B24"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir una foto de la galería para el jugador.",
          "cameraPermission": "Permite tomar una foto del jugador.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite usar el micrófono para anotar puntos por voz.",
          "speechRecognitionPermission": "Permite reconocer tu voz para anotar puntos. En algunos dispositivos el audio se envía a Apple o Google para transcribirlo."
        }
      ]
    ],
    "scheme": "dominopuntos",
    "backgroundColor": "#070B24",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B24"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
