# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Puerto HTTP de la API
PORT=4000

# ---------- Base de datos (PostgreSQL) ----------
# Supabase: Project Settings -> "Connect". Servidor que corre siempre (Render, Railway, tu PC):
#   Session pooler, p. ej. postgresql://postgres.[REF]:[CLAVE]@[HOST-DEL-POOLER]:5432/postgres
# Vercel u otro entorno serverless: Transaction pooler (puerto 6543).
# Si la contraseña tiene caracteres especiales (@ : / # ?), escríbelos codificados (%40, %3A, ...).
# Vacío = PostgreSQL embebido (PGlite) guardado en PGLITE_DIR, útil para desarrollo sin Supabase.
DATABASE_URL=

# Certificado raíz de Supabase (Database Settings -> SSL Configuration -> Download certificate).
# Con él la conexión va cifrada y se verifica que el servidor sea realmente Supabase.
DATABASE_SSL_CA=./supabase-ca.crt
# Alternativas: DATABASE_SSL=no-verify (cifra sin verificar, menos seguro) o DATABASE_SSL=disable (solo local).
DATABASE_SSL=

# Conexiones simultáneas por instancia (en Vercel usa 1).
DATABASE_POOL_MAX=5

# Carpeta de PGlite cuando DATABASE_URL está vacío.
PGLITE_DIR=./data/pglite

# Secreto para firmar los tokens de sesión. Obligatorio, mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración de la sesión (formato jsonwebtoken: 12h, 7d, ...)
JWT_EXPIRES_IN=12h

# Orígenes web permitidos (separados por coma). Vacío = cualquier origen.
# Las apps nativas no usan CORS; solo aplica a la versión web.
CORS_ORIGINS=

# Conteo de fichas con cámara (opcional). Clave privada de la API de Claude (Anthropic).
# Se obtiene en https://platform.claude.com -> API keys. Solo vive en el servidor, nunca en la app.
# Sin esta variable, la app ofrece "Contar a mano" y avisa que el análisis de fotos no está configurado.
ANTHROPIC_API_KEY=
