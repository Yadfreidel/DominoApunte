# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Puerto HTTP de la API
PORT=4000

# Ruta del archivo SQLite (se crea automáticamente)
DATABASE_PATH=./data/domino.db

# Secreto para firmar los tokens de sesión. Obligatorio, mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración de la sesión (formato jsonwebtoken: 12h, 7d, ...)
JWT_EXPIRES_IN=12h

# Orígenes web permitidos (separados por coma). Vacío = cualquier origen.
# Las apps nativas no usan CORS; solo aplica a la versión web.
CORS_ORIGINS=
